import os
import cdsapi

# set your download parameters here, then run the whole script
# bounding box seems to have to be NWSE in order
years = list(range(2022, 2025))
country = 'Myanmar'
bounding_box = [28.335945136, 92.3032344909, 9.93295990645, 101.180005324]
datasets = ['total_precipitation', '2m_temperature']

# Function to download ERA5-Land data
def download_era5_land(dataset, years, country, bounding_box):

    output_file = f"./outputs/{country}_{dataset}_{min(years)}_{max(years)}.nc"
    
    if os.path.exists(output_file):
        print(f"{output_file} already exists. Skipping download.")
        return
    
    c = cdsapi.Client()
    c.retrieve(
        'reanalysis-era5-land',
        {'variable': dataset,
         'year': years,
         'month': [f'{i}'.zfill(2) for i in range(1, 13)],
         'day': [f'{i}'.zfill(2) for i in range(1, 32)],
         'time': '12:00',
         'data_format': 'netcdf',
         'download_format': 'unarchived',
         'area': bounding_box},
        output_file)
    print(f"Data downloaded to {output_file}")

# download all datasets (can also bundle all datasets into one if easier to process)
for dataset in datasets:
    download_era5_land(dataset, years, country, bounding_box)
